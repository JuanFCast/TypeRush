# App (Supabase en el cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Script de premios + deploy del contrato (solo en tu máquina, nunca en el cliente)
SUPABASE_SERVICE_ROLE_KEY=
# LEGACY (premio fijo, TypeRushDailyPrizes) — desplegado en Celo Sepolia.
PRIZE_POOL_ADDRESS=
PRIVATE_KEY=

# Pay-to-play (TypeRushPayToPlay) — entrada en STABLECOIN (cUSD/USDm), split 50/50 dev/pozo.
# Cliente (frontend) y servidor/scripts apuntan a la MISMA dirección del contrato nuevo.
NEXT_PUBLIC_PAY_TO_PLAY_CONTRACT_ADDRESS=
PAY_TO_PLAY_CONTRACT_ADDRESS=
# Stablecoin de la entrada (Celo Sepolia testnet):
#   USDC: 0x01C5C0122039549AD1493B8220cABEdD739BC44E (6 decimales) — tiene faucet directo (faucet.circle.com)
#   USDm/cUSD: 0xEF4d55D6dE8e8d73232827Cd1e9b2F2dBb45bC80 (18 decimales)
NEXT_PUBLIC_PAY_TO_PLAY_STABLECOIN_ADDRESS=
PAY_TO_PLAY_STABLECOIN_ADDRESS=
# Entrada en la unidad mínima del token. USDC (6 dec): 0.10 = 100000 · USDm (18 dec): 0.10 = 100000000000000000.
NEXT_PUBLIC_PAY_TO_PLAY_ENTRY_AMOUNT=
PAY_TO_PLAY_ENTRY_AMOUNT=
# Decimales y símbolo del token para la UI (USDC: 6 / "USDC" · USDm: 18 / "cUSD").
NEXT_PUBLIC_PAY_TO_PLAY_TOKEN_DECIMALS=
NEXT_PUBLIC_PAY_TO_PLAY_TOKEN_SYMBOL=
# Wallet que recibe la mitad de cada entrada (obligatoria para desplegar el contrato nuevo).
TYPE_RUSH_DEV_WALLET=
# Opcional: owner/admin del contrato (si no, queda el deployer). Pon la wallet del dueño
# para que quien firma el deploy con PRIVATE_KEY no quede como admin.
PAY_TO_PLAY_OWNER_ADDRESS=
# Opcional: operador que paga los pozos (si no, el deployer es el distribuidor).
PAY_TO_PLAY_DISTRIBUTOR_ADDRESS=
