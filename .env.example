# =============================================================================
# TypeRush · variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a `.env.local` y rellena lo que necesites.
#
# Regla: `NEXT_PUBLIC_*` viaja al navegador y CUALQUIERA puede leerlo. Todo lo
# demás es solo servidor. Ninguna clave privada lleva ese prefijo, nunca.
#
# ⚠️ Las `NEXT_PUBLIC_*` se hornean en el BUILD: tras cambiarlas en Vercel hay
# que volver a desplegar para que surtan efecto.
# =============================================================================

# -----------------------------------------------------------------------------
# Modo de la app
# -----------------------------------------------------------------------------
# `development` → práctica local (sin cobro, sin ranking, sin firmar).
# `production` o vacío / ausente → flujo real on-chain (por defecto, fail-closed).
# ⚠️ En Vercel NO la pongas en development: cualquiera jugaría gratis en vivo.
# NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Dominio
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://typerush.fun

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypassa RLS. SOLO servidor y GitHub Actions. Jamás en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Privy (identidad + wallet embebida)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# -----------------------------------------------------------------------------
# WalletConnect / Reown
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# -----------------------------------------------------------------------------
# RPC de Celo (opcional; sin esto → Forno / failover)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CELO_RPC_URL=

# -----------------------------------------------------------------------------
# Sesión de wallet (servidor)
# -----------------------------------------------------------------------------
# Cadena aleatoria ≥ 32 caracteres. Firma las cookies de sesión wallet.
WALLET_SESSION_SECRET=

# =============================================================================
# Wallets del backend
# =============================================================================

# --- OPERATOR: welcome-gas + settle()/rollover() de V3 ------------------------
# Dirección en producción: 0xc91A86fC2eb29190dC670ee750A6F748F9D8b514
OPERATOR_PRIVATE_KEY=
# Alias legacy aceptado por lib/operator.ts y por close-day V2:
# OPERATOR_KEY=
OPERATOR_MIN_CELO=5

# --- FUNDER: siembra pozos (fundPot). Nunca saca dinero. ----------------------
# 0x46d5F9fE98461928DbAd7a22B95BADE5Fa178C18
PRIVATE_KEY=

# -----------------------------------------------------------------------------
# Gas inicial para wallets embebidas (sale del OPERATOR)
# -----------------------------------------------------------------------------
WELCOME_GAS_AMOUNT_CELO=0.1
WELCOME_GAS_IP_LIMIT=3
WELCOME_GAS_DAILY_CAP_CELO=25
WELCOME_GAS_IP_SALT=

# =============================================================================
# TypeRushGameV3 (PUSH) — juego activo
# =============================================================================
# El cliente exige AMBAS: bandera en "1" + dirección pública.
NEXT_PUBLIC_GAMEV3_CONTRACT_ADDRESS=0xD8287809e0D68E7e50D0D962f11Eb72150F48d39
NEXT_PUBLIC_GAMEV3_ENABLED=1
# Misma dirección para API / robots de servidor.
GAMEV3_CONTRACT_ADDRESS=0xD8287809e0D68E7e50D0D962f11Eb72150F48d39
CRON_SECRET=
# Con 0 el robot de settle solo planifica; con 1 transmite.
# Enciende en Vercel (Production) Y como Variable de GitHub Actions
# (respaldo `.github/workflows/settle-v3.yml`). El cron de Vercel dispara a
# 00:10 / 00:25 / 00:45 UTC; el de GitHub a 01:10 UTC.
GAMEV3_CRON_ENABLED=0
# Siembra de pozos V3, camino de RESPALDO (scripts/seed-v3.mjs +
# `.github/workflows/seed-v3.yml`, cada hora). Enciende como Variable de
# GitHub Actions = 1. Firma el FUNDER (`PRIVATE_KEY`), nunca el Operator.
# Completa hasta 0,30 USDT + 1.000 COPm por modalidad; correr dos veces no
# acumula.
GAMEV3_SEED_ENABLED=0

# Siembra de pozos V3, camino NORMAL: /api/cron/settle-v3 dispara la Edge
# Function `seed-v3` de Supabase justo después de liquidar cada modalidad,
# sin esperar al respaldo horario de arriba. Este secreto SOLO autoriza a
# Vercel a invocar esa Edge Function — nunca es la clave del Funder, que vive
# exclusivamente como secreto de Edge Function en Supabase y jamás llega aquí.
# Mismo valor en los dos lados: Vercel (esta variable) y Supabase → Edge
# Functions → Secrets → SEED_TRIGGER_SECRET (supabase/functions/seed-v3).
GAMEV3_SEED_TRIGGER_SECRET=

# =============================================================================
# TypeRushGameV2 — residual (ClaimBanner + robots de cierre/siembra V2)
# =============================================================================
# Mantener mientras haya premios `registered` por cobrar o pozos V2 vivos.
NEXT_PUBLIC_GAMEV2_CONTRACT_ADDRESS=0x22bda890153f9217ABf2F5B493c2B6E06b8c9336
NEXT_PUBLIC_GAMEV2_CHAIN_ID=42220
NEXT_PUBLIC_GAMEV2_USDT_ADDRESS=0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e
NEXT_PUBLIC_GAMEV2_COPM_ADDRESS=0x8A567e2aE79CA692Bd748aB832081C45de4041eA
GAMEV2_CONTRACT_ADDRESS=0x22bda890153f9217ABf2F5B493c2B6E06b8c9336

# Verificación de contratos en Celoscan (Etherscan API v2, chainid=42220).
CELOSCAN_API_KEY=
