# =============================================================================
# TypeRush · variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a `.env.local` y rellena lo que necesites.
#
# Regla: `NEXT_PUBLIC_*` viaja al navegador y CUALQUIERA puede leerlo. Todo lo
# demás es solo servidor. Ninguna clave privada lleva ese prefijo, nunca.
#
# ⚠️ Las `NEXT_PUBLIC_*` se hornean en el BUILD: tras cambiarlas en Vercel hay
# que volver a desplegar para que surtan efecto.
# =============================================================================

# -----------------------------------------------------------------------------
# Dominio
# -----------------------------------------------------------------------------
# Dominio oficial. Se usa para canonical, Open Graph, sitemap y robots.
NEXT_PUBLIC_SITE_URL=https://typerush.fun

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypassa RLS. SOLO servidor y GitHub Actions. Jamás en el cliente ni en un
# archivo con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Privy (identidad + wallet embebida)
# -----------------------------------------------------------------------------
# Crear la app en https://dashboard.privy.io → New app.
# SIN esto la app arranca igual, pero sin login por correo: solo wallets
# externas y MiniPay.
NEXT_PUBLIC_PRIVY_APP_ID=
# Panel de Privy → Settings → Basics → App secret. Solo servidor: con él se
# verifican los tokens y se lee la wallet embebida real del usuario.
PRIVY_APP_SECRET=

# -----------------------------------------------------------------------------
# WalletConnect / Reown
# -----------------------------------------------------------------------------
# Crear el proyecto en https://cloud.reown.com (antes WalletConnect Cloud).
# Sin esto, MetaMask/Rabby/MiniPay y las inyectadas SÍ funcionan; las que pasan
# por WalletConnect (Trust, Rainbow móvil, escaneo de QR) NO.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# -----------------------------------------------------------------------------
# RPC de Celo (opcional)
# -----------------------------------------------------------------------------
# Sin esto se usan los públicos con failover (Forno → dRPC). Un RPC propio
# (Alchemy, QuickNode…) evita los límites de tasa cuando haya tráfico.
NEXT_PUBLIC_CELO_RPC_URL=

# -----------------------------------------------------------------------------
# Gas inicial para wallets embebidas
# -----------------------------------------------------------------------------
# Wallet DEDICADA que regala el CELO inicial. NO reutilices la del operador del
# contrato: si esta se filtra, el daño se limita a su saldo.
WELCOME_GAS_PRIVATE_KEY=
# Cuánto CELO recibe cada wallet embebida nueva, una sola vez.
WELCOME_GAS_AMOUNT_CELO=0.1
# Máximo de airdrops por IP en 24 h.
WELCOME_GAS_IP_LIMIT=3
# Tope global de CELO por día. Cortafuegos si algo se descontrola.
WELCOME_GAS_DAILY_CAP_CELO=25
# Sal para hashear la IP (no se guarda la IP en claro). Cualquier cadena larga.
WELCOME_GAS_IP_SALT=

# -----------------------------------------------------------------------------
# Turnstile (anti-Sybil del gas inicial)
# -----------------------------------------------------------------------------
# https://dash.cloudflare.com → Turnstile → Add site.
# Sin la clave secreta el captcha se salta y todo pasa: útil en desarrollo,
# NO dejarlo así en producción.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# TypeRushGameV3 (PUSH) — TODAVÍA NO ACTIVO
# -----------------------------------------------------------------------------
# El frontend sigue jugando contra V2 hasta que AMBAS estén puestas: la
# dirección de un contrato desplegado y la bandera en "1". Ver contracts/RUNBOOK-V3.md.
NEXT_PUBLIC_GAMEV3_CONTRACT_ADDRESS=
NEXT_PUBLIC_GAMEV3_ENABLED=0
# Mismos valores, para scripts y robots del servidor.
GAMEV3_CONTRACT_ADDRESS=
# Bot que cierra rondas: solo puede settle() y rollover(). No retira nada.
GAMEV3_OPERATOR_PRIVATE_KEY=
# Secreto compartido con el cron que dispara la liquidación.
CRON_SECRET=

# --- Despliegue de V3 (solo al correr forge script) --------------------------
# Quien FIRMA el deploy. No debe ser el owner: no conserva ningún poder.
# PRIVATE_KEY se reutiliza de más abajo.
GAMEV3_OWNER=
GAMEV3_OPERATOR=
GAMEV3_TREASURY=
GAMEV3_USDT=0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e
GAMEV3_COPM=0x8A567e2aE79CA692Bd748aB832081C45de4041eA
GAMEV3_PROTOCOL_BPS=2000
GAMEV3_USDT_ENTRY=100000
GAMEV3_COPM_ENTRY=500000000000000000000

# =============================================================================
# TypeRushGameV2 (ACTIVO) — no tocar mientras tenga pozos pendientes
# =============================================================================
NEXT_PUBLIC_GAMEV2_CONTRACT_ADDRESS=0x22bda890153f9217ABf2F5B493c2B6E06b8c9336
NEXT_PUBLIC_GAMEV2_CHAIN_ID=42220
NEXT_PUBLIC_GAMEV2_USDT_ADDRESS=0x48065fbBE25f71C9282ddf5e1cD6D6A887483D5e
NEXT_PUBLIC_GAMEV2_COPM_ADDRESS=0x8A567e2aE79CA692Bd748aB832081C45de4041eA
GAMEV2_CONTRACT_ADDRESS=0x22bda890153f9217ABf2F5B493c2B6E06b8c9336
# Operador de V2: cierra rondas y siembra pozos. Se sigue necesitando hasta el
# apagado natural (incluye cerrar la ronda huérfana del día 20638).
PRIVATE_KEY=
OPERATOR_KEY=
PRIZE_POOL_ADDRESS=

# Verificación de contratos en Celoscan (chainid=42220).
CELOSCAN_API_KEY=
